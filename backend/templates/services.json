[
  {
    "id": "payrun",
    "name": "Payrun service",
    "domain": "Payroll",
    "enabled": true,
    "base_url_env": "PAYRUN_API_BASE_URL",
    "method": "GET",
    "path": "/payruns",
    "operations": [
      {
        "method": "GET",
        "path": "/payruns",
        "access": "R"
      },
      {
        "method": "POST",
        "path": "/payruns",
        "access": "W",
        "description": "Write permission only; agent payroll writes are not implemented."
      },
      {
        "method": "POST",
        "path": "/graphql",
        "access": "R",
        "description": "Read-only GraphQL payroll queries."
      },
      {
        "method": "PUT",
        "path": "/payruns/{payrunId}/paychecks/{lineId}",
        "access": "W"
      }
    ]
  },
