# Temporary Apollo host; build with backend/ as the context so the proto is available.
FROM node:22-bookworm-slim

WORKDIR /app/graphql
COPY graphql/package.json graphql/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

COPY graphql/*.js ./
COPY registry/proto/templates.proto /app/registry/proto/templates.proto

EXPOSE 4000
# Mount local_server at runtime; local settings are excluded from this image.
CMD ["node", "../local_server/apollo.js"]
