# Copy to .env (cp .env.example .env). Every value is optional; the defaults suit local development.
# Read by docker-compose.yaml (published images).

# URL path the UI is mounted under (default /ai_studio/). Change it to plug the UI into
# another host, e.g. /paycalendar/ai_studio/; nothing else needs editing.
# STUDIO_BASE_PATH=/ai_studio/

# Pin a published image version (a git short SHA) instead of latest.
# IMAGE_TAG=latest

# Django settings used by backend/local_server/studio/settings.py.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Hugging Face User Access Token for agent model calls (fine-grained, permission
# "Make calls to Inference Providers"). Used only by the Apollo server; never commit it.
# HF_TOKEN=
# Optional: another OpenAI-compatible endpoint instead of https://router.huggingface.co/v1
# HF_INFERENCE_BASE_URL=

# Optional: where incident reports are emailed (POST <EMAIL_API_BASE_URL>/notifications/email).
# EMAIL_API_BASE_URL=
# INCIDENT_EMAIL_TO=payroll-team@example.com
