# Copy to .env (cp .env.example .env). Every value is optional; the defaults suit local development.

# Load the sample agents into an empty database so everyone starts with the same registry.
SEED_SAMPLE_AGENTS=true

# Django settings. DJANGO_SECRET_KEY is required if DJANGO_DEBUG is false.
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Pin a published image version (a git short SHA) instead of latest.
# IMAGE_TAG=latest
