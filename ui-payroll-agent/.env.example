# Default: real GraphQL service backed by gRPC and SQLite.
GRAPHQL_MODE=backend
API_PROXY_TARGET=http://127.0.0.1:4000

# For the standalone in-memory demo instead:
# GRAPHQL_MODE=mock

# Where the sidebar's "TriNet Payruns" link opens the separate mock TriNet UI (ui-trinet-mock).
VITE_TRINET_MOCK_URL=http://localhost:5174/trinet/
