          "Which payments need review?"
        ],
        "domain": "Payroll",
        "model": "poc-demo",
        "service": "payrun",
        "page": "payrun",
        "attached_services": [
          "payrun-history"
        ],
        "created_by": "poc-user",
        "roles": [],
        "capabilities": {
          "alerts": {
            "enabled": true,
            "severity": "warning"
          },
          "webhooks": {
            "enabled": false,
            "url": ""
